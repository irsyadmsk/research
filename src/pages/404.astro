---
import Base from "../layouts/Base.astro";
---
<Base title="Halaman tidak ditemukan" description="Halaman yang kamu cari tidak ada di Irsyads Research.">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>Halaman ini belum kami temukan di lapangan.</h1>
    <p>Alamatnya mungkin salah ketik atau halamannya sudah dipindah.</p>
    <div class="cta">
      <a class="btn btn-primary" href="/">Kembali ke beranda</a>
      <a class="btn" href="/alat/judul/">Racik judul</a>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: 80px 24px; max-width: 720px; }
  h1 { font-family: var(--f-display); font-size: clamp(30px, 4.6vw, 44px); line-height: 1.12; margin: 0; }
  p { color: var(--muted); font-size: 17px; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
</style>
