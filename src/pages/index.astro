---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const karya = (await getCollection("karya")).filter((k) => k.data.izin);
const ruang = [
  {
    href: "/alur/",
    tag: "Panduan",
    judul: "Alur Penelitian",
    isi: "Sembilan langkah dari menemukan masalah sosial sampai mempresentasikan hasil, dengan catatan untuk kelas 10 dan mahasiswa.",
    aksi: "Ikuti alurnya",
  },
  {
    href: "/alat/judul/",
    tag: "Alat",
    judul: "Racik Judul Sosiologi",
    isi: "Susun judul kualitatif atau kuantitatif lengkap dengan teori, rumusan masalah, dan hipotesis awal.",
    aksi: "Racik judul",
  },
  {
    href: "/teori/",
    tag: "Glosarium",
    judul: "Teori dan Konsep",
    isi: "Ringkasan teori tokoh untuk mahasiswa dan konsep dasar untuk kelas 10, lengkap dengan contoh fokus penelitian.",
    aksi: "Buka glosarium",
  },
  {
    href: "/karya/",
    tag: karya.length ? `${karya.length} karya` : "Segera tayang",
    judul: "Karya Murid",
    isi: "Etalase penelitian sosiologi murid: abstrak, laporan, dan poster yang sudah melewati bimbingan.",
    aksi: "Lihat karya",
  },
];
---
<Base
  title="Irsyads Research · Ruang Riset Sosiologi"
  description="Ruang belajar penelitian sosiologi untuk siswa SMA kelas 10 dan mahasiswa: alur penelitian, pembuat judul, dan karya murid."
  active="beranda"
>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow reveal">Ruang Riset Sosiologi</p>
      <h1 class="reveal" style="--i:1">Belajar meneliti masyarakat, dari judul sampai presentasi.</h1>
      <p class="lede reveal" style="--i:2">
        Panduan, alat bantu, dan etalase karya untuk siswa SMA kelas 10 dan mahasiswa yang sedang menyusun penelitian sosiologi.
      </p>
      <div class="cta reveal" style="--i:3">
        <a class="btn btn-primary" href="/alat/judul/">Racik judul penelitian <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href="/alur/">Lihat alur penelitian</a>
        <a class="btn" href="/teori/">Glosarium teori</a>
      </div>
    </div>

    <figure class="sample reveal" style="--i:3" aria-label="Contoh hasil Racik Judul">
      <figcaption>Contoh hasil Racik Judul</figcaption>
      <div class="sample-card">
        <div class="chips"><span class="chip qual">Kualitatif</span><span class="tag">Studi Kasus</span><span class="tag">Interaksi Sosial</span></div>
        <p class="sample-title">Bentuk Interaksi Sosial Pengrajin Gerabah dalam Komunitas Perajin di Kecamatan Plered, Kabupaten Purwakarta</p>
        <p class="sample-q"><span>Rumusan masalah</span>Bagaimana bentuk interaksi sosial (kerja sama, persaingan, atau konflik) yang terjadi di antara pengrajin gerabah?</p>
      </div>
      <div class="sample-card back" aria-hidden="true">
        <div class="chips"><span class="chip quant">Kuantitatif</span><span class="tag">Angket</span></div>
        <p class="sample-title">Pengaruh Intensitas Penggunaan Media Sosial terhadap Interaksi Sosial dengan Keluarga pada Pelajar SMA di Purwakarta</p>
      </div>
    </figure>
  </section>

  <section class="wrap rooms" aria-labelledby="ruang-h">
    <h2 id="ruang-h" class="section-h">Empat ruang untuk memulai</h2>
    <div class="room-grid">
      {ruang.map((r, i) => (
        <a class="room reveal" href={r.href} style={`--i:${i + 4}`}>
          <span class="room-tag">{r.tag}</span>
          <h3>{r.judul}</h3>
          <p>{r.isi}</p>
          <span class="room-go">{r.aksi} <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap levels" aria-labelledby="jenjang-h">
    <h2 id="jenjang-h" class="section-h">Satu ruang, dua jenjang</h2>
    <div class="level-grid">
      <article class="level">
        <p class="eyebrow">SMA Kelas 10</p>
        <h3>Penelitian sosial sederhana</h3>
        <ul>
          <li>Konsep dasar: interaksi sosial, nilai dan norma, sosialisasi, gejala sosial.</li>
          <li>Data dari observasi, wawancara 3–5 narasumber, atau angket satu kelas.</li>
          <li>Judul ringkas, paling banyak sekitar 15 kata.</li>
        </ul>
      </article>
      <article class="level">
        <p class="eyebrow">Mahasiswa</p>
        <h3>Skripsi dan artikel ilmiah</h3>
        <ul>
          <li>Teori tokoh: Berger dan Luckmann, Goffman, Bourdieu, Weber, Giddens, dan lainnya.</li>
          <li>Desain studi kasus, fenomenologi, etnografi, survei, hingga eksperimen semu.</li>
          <li>Rumusan masalah dan hipotesis yang siap diuji.</li>
        </ul>
      </article>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 48px; align-items: center; padding-block: 64px 56px; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; gap: 40px; padding-block: 40px 32px; } }
  h1 { font-family: var(--f-display); font-weight: 700; font-size: clamp(34px, 5.4vw, 60px); line-height: 1.06; letter-spacing: -0.015em; margin: 0; }
  .lede { font-size: clamp(16px, 1.6vw, 18px); color: var(--muted); max-width: 52ch; margin: 18px 0 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }

  .sample { position: relative; margin: 0; padding: 0 0 36px 0; min-width: 0; }
  .sample figcaption { font-family: var(--f-mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .sample-card { position: relative; z-index: 2; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 22px; box-shadow: var(--shadow); transition: transform 0.5s var(--ease); }
  .sample-card.back { position: absolute; z-index: 1; left: 28px; right: -12px; bottom: 0; opacity: 0.75; transform: rotate(2deg); padding-block: 16px 18px; }
  .sample:hover .sample-card:not(.back) { transform: translateY(-4px) rotate(-0.6deg); }
  .sample:hover .sample-card.back { transform: rotate(3.5deg) translateY(6px); }
  @media (max-width: 520px) { .sample-card.back { right: 0; left: 18px; } }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .chip { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; padding: 3px 8px; border-radius: 5px; }
  .chip.qual { background: var(--qual-soft); color: var(--qual); }
  .chip.quant { background: var(--quant-soft); color: var(--quant); }
  .tag { font-size: 12px; padding: 2px 8px; border-radius: 5px; border: 1px solid var(--line); color: var(--muted); }
  .sample-title { font-family: var(--f-serif); font-size: 17px; line-height: 1.5; margin: 0; }
  .back .sample-title { font-size: 14px; }
  .sample-q { margin: 14px 0 0; font-size: 14px; color: var(--muted); }
  .sample-q span { display: block; font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; margin-bottom: 2px; }

  .section-h { font-family: var(--f-display); font-size: clamp(24px, 3vw, 32px); margin: 0 0 20px; }
  .rooms { padding-block: 24px; }
  .room-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 720px) { .room-grid { grid-template-columns: 1fr; } }
  .room { display: flex; flex-direction: column; gap: 8px; padding: 24px; border-radius: var(--r); background: var(--surface); border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: transform 0.3s var(--ease), box-shadow 0.3s, border-color 0.3s; }
  .room:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--accent); }
  .room-tag { font-family: var(--f-mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .room h3 { font-family: var(--f-display); font-size: 24px; margin: 0; }
  .room p { margin: 0; color: var(--muted); font-size: 15px; }
  .room-go { margin-top: auto; padding-top: 12px; font-weight: 600; font-size: 14px; color: var(--accent); }
  .room-go .arrow { display: inline-block; transition: transform 0.2s var(--ease); }
  .room:hover .room-go .arrow { transform: translateX(4px); }

  .levels { padding-block: 48px 0; }
  .level-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 720px) { .level-grid { grid-template-columns: 1fr; } }
  .level { padding: 24px; border-radius: var(--r); border: 1px dashed var(--line); }
  .level h3 { font-family: var(--f-display); font-size: 22px; margin: 0 0 12px; }
  .level ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; color: var(--muted); font-size: 15px; }
</style>
